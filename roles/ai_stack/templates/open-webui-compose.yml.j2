---

services:
  open-webui:
    container_name: {{ ai_stack_open_webui_container_name }}
    hostname: {{ ai_stack_open_webui_container_name }}
    image: {{ ai_stack_open_webui_image }}
    restart: unless-stopped
    ports:
      - "{{ ai_stack_open_webui_host_port }}:8080"  # Open WebUI web interface
    networks:
      - homelab-bridge
    dns:
      - {{ ai_stack_monolith_ip }}  # Host IP where Pi-hole DNS binds on port 53
      - 1.1.1.1  # Cloudflare DNS for reliable external resolution
      - 8.8.8.8  # Google DNS fallback
    dns_search:
      - local  # Optional: for local domain resolution
    volumes:
      - type: bind
        source: {{ ai_stack_open_webui_data_path }}
        target: /app/backend/data
        read_only: false
{% for storage_mount in ai_stack_shared_storage_mounts %}
      - type: bind
        source: {{ storage_mount.source }}
        target: {{ storage_mount.target }}
        read_only: {{ 'true' if storage_mount.read_only | default(false) else 'false' }}
{% endfor %}
    environment:
      TZ: {{ ai_stack_timezone }}
      # Ollama backend configuration
      OLLAMA_BASE_URL: "http://{{ ai_stack_ollama_container_name }}:{{ ai_stack_ollama_internal_port }}"
      # Optional: Set default model (update after deployment)
      WEBUI_DEFAULT_MODELS: "{{ ai_stack_open_webui_default_models }}"
      WHISPER_COMPUTE_TYPE: "{{ ai_stack_open_webui_whisper_compute_type }}"
    deploy:
      replicas: 1
      resources:
        limits:
          memory: {{ ai_stack_open_webui_memory_limit }}
        reservations:
          memory: {{ ai_stack_open_webui_memory_reservation }}
      update_config:
        order: start-first
        failure_action: rollback

networks:
  homelab-bridge:
    name: homelab-bridge
    external: true
